# Contexto de build: deploy/docker-compose.yml usa context: .. (la raiz del
# repo), asi que esto se aplica a TODO lo que entra a la imagen "web".

.git/
.gitignore
.dockerignore
venv/
__pycache__/
*.pyc

# Secretos / entorno local (se inyectan via deploy/.env en runtime, nunca
# se copian a la imagen)
.env
deploy/.env
deploy/respaldos/

# Datos locales que no deben viajar en la imagen - EXCEPTO los 3 que si se
# hornean a proposito porque son pesados de re-extraer de Moodle (mismo
# criterio que el .gitignore, debe quedar identico para que lo que entra al
# repo tambien entre a la imagen).
db.sqlite3
data/raw/*.json
!data/raw/categorias.json
!data/raw/carreras.json
!data/raw/linkcarreras.json
staticfiles/
notas*.xlsx

# Contenido fuera del alcance de la app (ya excluido del repo tambien)
/Versioines Demo/
/Proyecto de grado/

# Editor / SO
.vscode/
*.swp
Thumbs.db
