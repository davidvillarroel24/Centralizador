# Copia este archivo a .env y completa tus propios valores.
# .env NUNCA debe subirse al repositorio (se excluira en .gitignore).

DJANGO_SECRET_KEY=cambia-esto-por-una-clave-secreta-unica
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# URL del Moodle institucional
MOODLE_BASE_URL=https://tu-moodle.example.edu

# Cookie MoodleSession capturada manualmente (ver /web/session-cookie/).
# Temporal: en la Fase 2 esto se reemplaza por credenciales cifradas por usuario
# en la base de datos (ver PLAN_DESARROLLO.md seccion 5).
MOODLE_SESSION_COOKIE=

# Se completa en el paso de migracion a Postgres (PLAN_DESARROLLO.md seccion 2).
# Si no esta definida, el proyecto sigue usando SQLite.
# DATABASE_URL=postgres://usuario:password@localhost:5432/centralizador
