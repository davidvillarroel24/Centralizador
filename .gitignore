# Entorno / secretos
.env
deploy/.env
deploy/respaldos/
venv/
__pycache__/
*.pyc
gatfh/config_runtime.json
gatfh/sesskey.json
gatfh/config_tareas.json

# Base de datos local
db.sqlite3

# Estaticos generados (se regeneran en el build de Render)
/staticfiles/

# Datos scrapeados (contienen informacion real de estudiantes/docentes)
data/raw/*.json
# Excepcion: carreras/categorias/linkcarreras no traen datos de estudiantes (solo
# facultades/carreras/materias/profesores) y son los mas pesados de re-extraer de
# Moodle; se versionan para poder probar la importacion a BD (ej. en el VPS) sin
# tener que volver a correr "0. Extraer carreras" cada vez.
!data/raw/categorias.json
!data/raw/carreras.json
!data/raw/linkcarreras.json
# Dataset del modelo de riesgo (contiene ids de estudiantes reales)
data/ml/*.csv

notas*.xlsx
notas1*.xlsx
notas2*.xlsx
debug.html
data_dump.json
dumpdata_errors.log
MIGRACION_DATOS_RENDER.md

# Carpetas fuera del alcance del repo de la app
/Versioines Demo/
/Proyecto de grado/

# Editor / SO
.vscode/
*.swp
Thumbs.db
