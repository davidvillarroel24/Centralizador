# Copiar a .env (en esta misma carpeta, deploy/) y completar.
# .env NUNCA debe subirse al repositorio (ya esta en .gitignore).

# Dominio publico de este proyecto en el VPS compartido (lo lee el proxy
# compartido via la etiqueta "caddy" del servicio web, ver docker-compose.yml).
DOMINIO=centralizador-tecba.duckdns.org

# Postgres (red interna "centralizador_interna": no accesible desde afuera
# del VPS ni desde los otros proyectos). Generar la password con:
#   openssl rand -hex 32
POSTGRES_DB=centralizador
POSTGRES_USER=centralizador
POSTGRES_PASSWORD=cambia-esto-generando-con-openssl-rand-hex-32

# Django. Generar el secret igual que la password de arriba.
DJANGO_SECRET_KEY=cambia-esto-generando-con-openssl-rand-hex-32
DJANGO_DEBUG=False

# Moodle institucional (igual que en el .env.example de la raiz del repo).
MOODLE_BASE_URL=https://tu-moodle.example.edu

# MOODLE_SESSION_COOKIE NO se define aca a proposito: en produccion cada
# usuario pega su propia cookie en /session-cookie/ y queda solo en su
# sesion de navegador (SESSION_ENGINE=signed_cookies, nunca en la base de
# datos ni en variables de entorno compartidas). Ver D1b en el README del
# repo si hace falta un fallback para correr un comando CLI suelto.
